# ================================================
# SAVORY — Environment Variables Example
# ================================================
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to version control.

# ============================
# FRONTEND — Supabase (Vite)
# ============================
# Found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================
# SUPABASE EDGE FUNCTIONS
# ============================
# These are automatically injected by Supabase into Edge Functions.
# You do NOT need to set these manually in Supabase — they are built-in.
# SUPABASE_URL=               (auto-injected)
# SUPABASE_SERVICE_ROLE_KEY=  (auto-injected)

# ============================
# NOTIFICATIONS — Telegram Bot
# ============================
# Set these in: Supabase Dashboard → Edge Functions → Secrets
# 1. Create a bot via @BotFather on Telegram → copy the token
# 2. Get your chat/group ID via @userinfobot or the Telegram API
NOTIFICATION_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
NOTIFICATION_CHAT_ID=-1001234567890

# ============================
# NOTIFICATIONS — Discord (optional)
# ============================
# Create a webhook in your Discord server → Channel Settings → Integrations
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-url

# ============================
# PAYMENT — KHQR / Bakong
# ============================
# Set these server-side in: Supabase Dashboard → Edge Functions → Manage secrets
# NEVER put these in .env (frontend) — they must stay server-side only
KHQR_BASE_URL=https://api-bakong.nbc.gov.kh
KHQR_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
KHQR_ACCOUNT=yourname@bkrt
KHQR_MERCHANT_NAME=YOUR MERCHANT NAME
BAKONG_STORE_LABEL=Savory
KHQR_USD_TO_KHR_RATE=4100

# ============================
# NOTES
# ============================
# - All Edge Function secrets must be set in Supabase Dashboard:
#     Project → Edge Functions → Manage secrets
# - Frontend (.env) variables must start with VITE_ to be exposed to the browser
# - Never put secret keys (payment, bot tokens, service role) in VITE_ variables
